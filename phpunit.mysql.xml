<?xml version="1.0" encoding="UTF-8"?>
<!--
    Konfigurasi pengujian fitur yang memerlukan MySQL (Kas dan Dashboard).
    Berbeda dari phpunit.xml: memakai koneksi MySQL "pos" dari .env (model aplikasi memakai koneksi ini dan skema
    memakai fitur khusus MySQL). Setiap test dibungkus transaksi database yang di-rollback, sehingga data tidak tersimpan.
    Jalankan hanya pada database pengembangan/testing: gunakan opsi configuration dengan file ini
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="MySQL">
            <directory>tests/Feature/Cash</directory>
            <directory>tests/Feature/Dashboard</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
